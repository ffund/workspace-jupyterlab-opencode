#!/usr/bin/env bash
set -e

export XDG_CONFIG_HOME=/tmp/opencode-config
mkdir -p "${XDG_CONFIG_HOME}/opencode"
if [[ ! -f "${XDG_CONFIG_HOME}/opencode/opencode.json" ]]; then
    cp /opt/opencode-config/opencode.json "${XDG_CONFIG_HOME}/opencode/opencode.json"
fi
exec /opt/opencode/.opencode/bin/opencode "$@"
